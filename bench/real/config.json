{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "enforce_auth_on_inference": false
  },
  "governance": {
    "routing_rules": [
      {
        "id": "real-random",
        "name": "real-random",
        "cel_expression": "model == \"real-random\"",
        "targets": [
          {"provider": "anthropic", "model": "VERIFY-claude-haiku-5-5", "weight": 0.7},
          {"provider": "openai", "model": "VERIFY-openai-small-model", "weight": 0.3}
        ],
        "sticky_sessions": false,
        "scope": "global",
        "priority": 0
      },
      {
        "id": "real-sticky",
        "name": "real-sticky",
        "cel_expression": "model == \"real-sticky\"",
        "targets": [
          {"provider": "anthropic", "model": "VERIFY-claude-haiku-5-5", "weight": 0.7},
          {"provider": "openai", "model": "VERIFY-openai-small-model", "weight": 0.3}
        ],
        "sticky_sessions": true,
        "scope": "global",
        "priority": 1
      }
    ]
  },
  "providers": {
    "anthropic": {
      "keys": [
        {"name": "anthropic-key", "value": "env.ANTHROPIC_API_KEY", "models": ["*"], "weight": 1.0}
      ],
      "prompt_cache": {"auto_inject": true}
    },
    "openai": {
      "keys": [
        {"name": "openai-key", "value": "env.OPENAI_API_KEY", "models": ["*"], "weight": 1.0}
      ]
    }
  }
}
